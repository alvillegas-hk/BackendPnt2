# ========================================
# CONFIGURACIÓN DE LA APP
# ========================================
APP_ENV=development
APP_DEBUG=true
APP_NAME=GameManager
APP_VERSION=1.0.0

# ========================================
# AMBIENTE
# ========================================
# Valores: "development" o "production"
ENVIRONMENT=development

# ========================================
# SEGURIDAD
# ========================================
SECRET_KEY=gamemanager-secret-key-2024

# ========================================
# BASE DE DATOS
# ========================================
DATABASE_URL=sqlite:///./sqlite.db

# ========================================
# ADMIN SEED USER
# ========================================
# Usuario administrador para inicialización (dev/testing)
ADMIN_EMAIL=alfredo.villegas.hk@gmail.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO

# ========================================
# COOKIES - TIEMPOS DE EXPIRACIÓN
# ========================================
# Access Token: tiempo en MINUTOS
# Default: 15 minutos
# Ejemplos:
#   5 = 5 minutos (desarrollo/testing)
#   15 = 15 minutos
#   60 = 1 hora
#   480 = 8 horas
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh Token: tiempo en DÍAS
# Default: 7 días
# Ejemplos:
#   1 = 1 día
#   7 = 7 días (recomendado)
#   30 = 30 días
REFRESH_TOKEN_EXPIRE_DAYS=7
